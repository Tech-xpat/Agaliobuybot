# ───────── Telegram ─────────
# From @BotFather. NEVER commit the real value.
TELEGRAM_BOT_TOKEN=
# Numeric chat ID of AGALIO NETWORK (supergroups look like -1001234567890).
TELEGRAM_GROUP_ID=
# Comma-separated numeric Telegram USER IDs allowed to run admin commands (primary admins).
TELEGRAM_ADMIN_IDS=
# Public invite link of the community group (used for the Telegram button).
TELEGRAM_GROUP_URL=https://t.me/agalionetwork

# ───────── Infrastructure ─────────
DATABASE_URL=postgresql://agalio:change_me@localhost:5432/agalio?schema=public
REDIS_URL=redis://localhost:6379

# ───────── BNB Smart Chain ─────────
BSC_CHAIN_ID=56
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org
# Strongly recommended: a second provider for failover.
BSC_FALLBACK_RPC_URL=
RPC_TIMEOUT_MS=8000
RPC_MAX_RETRIES=3
BSCSCAN_BASE_URL=https://bscscan.com

# ───────── AGALIO token (first-run seed only; afterwards the database is the source of truth) ─────────
AGALIO_TOKEN_NAME=AGALIO
AGALIO_TOKEN_SYMBOL=AGALIO
# Leave empty until the contract is deployed, then use /setcontract (recommended) or set here before first start.
AGALIO_CONTRACT_ADDRESS=
# Buy URL may contain {contract}. Only shown when launch status is TRADING_LIVE.
AGALIO_BUY_URL=
AGALIO_CHART_URL=
AGALIO_COMMUNITY_URL=
AGALIO_WEBSITE_URL=
AGALIO_LOGO_PATH=assets/logo.png

# ───────── Market data ─────────
DEXSCREENER_API_BASE_URL=https://api.dexscreener.com
MARKET_REFRESH_SECONDS=60
MARKET_TIMEOUT_MS=8000
MARKET_MAX_RETRIES=2

# ───────── Runtime ─────────
# polling (default, simplest) or webhook (needs a public HTTPS URL)
BOT_MODE=polling
# webhook mode only:
WEBHOOK_URL=
# 16-256 chars: A-Z a-z 0-9 _ -   (e.g. output of: openssl rand -hex 32)
WEBHOOK_SECRET=
PORT=3000

ANNOUNCEMENT_ENABLED=true
ANNOUNCEMENT_COOLDOWN_SECONDS=60
USER_RATE_LIMIT_PER_MINUTE=20

LOG_LEVEL=info

# ───────── Buy alerts ─────────
# Posts a card in the group whenever the official token is bought on a DEX pool (read from BSC logs).
BUY_ALERT_ENABLED=true
# Ignore buys worth less than this many USD (dust / spam filter). 0 = alert on every buy.
BUY_ALERT_MIN_USD=1
# How often to scan new blocks for buys.
BUY_ALERT_POLL_SECONDS=10
# Flood control: max cards per scan. Extra buys are summarised in one line.
BUY_ALERT_MAX_PER_SCAN=5

# ───────── docker-compose only ─────────
POSTGRES_USER=agalio
POSTGRES_PASSWORD=change_me
POSTGRES_DB=agalio
